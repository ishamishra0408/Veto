DESCRIPTION >
    Evidence counts for one veto session — same definitions as evidence.ts (north star, counter, gate p95 guardrail).

NODE evidence
SQL >
    %
    SELECT
        countIf(kind = 'pin') AS pinned,
        sumIf(n_drifted, kind = 'receipt') AS drifted_flagged,
        countIf(kind = 'run' AND drifted = 1) AS shipped_contradictions,
        countIf(kind = 'run' AND verdict = 'CLEAN' AND shipped = 1) AS clean_shipped,
        countIf(kind = 'run' AND verdict = 'REFUSED' AND mode = 'clean') AS false_refusals,
        countIf(kind = 'run' AND verdict = 'REFUSED' AND mode = 'live') AS unforced_refusals,
        arrayElement(arraySort(groupArrayIf(gate_ms, kind = 'run')), toUInt32(ceil(0.95 * countIf(kind = 'run')))) AS gate_p95_ms
    FROM (
        SELECT * FROM vault_events
        WHERE session = {{ String(session, required=True) }}
        LIMIT 1 BY kind, event_id
    )

TYPE ENDPOINT
